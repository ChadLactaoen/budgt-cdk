{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "es2020",
      "dom"
    ],
    // `npm run build` is a type-check only: nothing consumes tsc's output. CDK runs
    // through ts-node, the Lambda is bundled by esbuild, and Jest by ts-jest. Emitting
    // would drop a .js beside every .ts — invisible, because .gitignore ignores them —
    // and Vite resolves `@shared/categories` to the .js in preference to the .ts, which
    // breaks the frontend dev server with a missing-export error.
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "inlineSourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "bin/**/*.ts",
    "lib/**/*.ts",
    "lambda/**/*.ts",
    "shared/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": ["node_modules", "cdk.out", "frontend"]
}
